rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read, admin write
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /participants/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // Authenticated users can claim an unclaimed slot — only the uid field,
      // only when currently null, and only to their own uid.
      allow update: if isAuthenticated()
        && resource.data.uid == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
    }

    match /teams/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /standings/{group} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Aggregated prediction leaderboard, maintained by the sync job (admin SDK bypasses rules)
    match /leaderboard/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prizeWinners/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Predictions: authenticated read, own-write, editable until kickoff
    match /predictions/{predId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.predictedHome is int
        && request.resource.data.predictedAway is int
        && request.resource.data.predictedHome >= 0
        && request.resource.data.predictedAway >= 0;

      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    // User profile: own record only; admin can read all
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isAdmin();
    }
  }
}
